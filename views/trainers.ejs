<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Trainers Homepage</title>
    <link rel="stylesheet" href="/trainers.css">
  </head>
  <body>
    <h1>Your Trainers</h1>
    <a href="/pokemon/wild">Wild Area</a>
    <button command="show-modal" commandfor="add-new-trainer-dialog">Create New Trainer</button>
    <dialog id="add-new-trainer-dialog">
      <button commandfor="add-new-trainer-dialog" command="close">Close</button>
      <p>Add a new Trainer</p>
      <form action="/trainer/new" method="POST">
        <label for="trainer-name">Name: </label>
        <input type="text" id="trainer-name" name="trainer_name" maxlength="12">
        <br>
        <label for="character-type">Choose a character:</label> 
        <select name="character_type" id="character-type">
          <option value="male">Male</option>
          <option value="female">Female</option>
        </select>
        <br>
        <button type="submit">Submit</button>
      </form>
    </dialog>
    <div class="trainer-card-container">
      <% results.map(result => { %>
        <div class="card">  
        <div class="info-container">
          <div class="stats-container">
            <p>Trainer ID: <%= result.id %></p>
            <p>Name: <%= result.name %></p>
            <p>Gender: <%= result.character_type %></p>
            <p>Gym Badges: <%= result.no_gym_badges %></p>
        </div>
        <div class="character-img-container">
          <% if(result.character_type === "male") { %>
            <img src="/brendan-e.png" alt="brendan-e">
          <% }else { %>
            <img src="/may-e.png" alt="brendan-e">
        <% } %>
        </div>
        </div>
          <div class="buttons-container">
            <a href="/trainer/<%= result.id %>/update">Update</a> <a href="/pokemon/from/<%= result.id %>">Show Pokemon</a>
            <button command="show-modal" commandfor="delete-trainer-<%= result.id %>-dialog">Delete</button>
            <dialog id="delete-trainer-<%= result.id %>-dialog">
              <button commandfor="delete-trainer-<%= result.id %>-dialog" command="close">Close</button>
              <form action="/trainer/<%= result.id %>/delete" method="POST">
                <p>Are you sure you want to delete this trainer <%= result.id %>?</p>
                <button type="submit">Confirm</button>
              </form>
            </dialog>
          </div>
        </div>
      <% }) %>
    </div>
  </body>
</html>
